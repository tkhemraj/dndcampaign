# Discord bot token — required
DISCORD_TOKEN=your-bot-token-here

# Set to 1 to share the FastAPI app's database (reads ../dndcampaign.db)
# Set to 0 to use the bot's own standalone database (discord_bot/campaign.db)
USE_SHARED_DB=0

# Optional: override the DB path (only used when USE_SHARED_DB=0)
# BOT_DB_PATH=discord_bot/campaign.db
